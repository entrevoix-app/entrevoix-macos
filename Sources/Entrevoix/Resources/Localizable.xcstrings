    "onboarding.connection.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This test is optional: speak a short phrase, then Entrevoix will send it to your STT provider. The test transcription is not retained." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Ce test est facultatif : prononcez une courte phrase, puis Entrevoix l’enverra à votre fournisseur STT. La transcription de test n’est pas conservée." } } } },
