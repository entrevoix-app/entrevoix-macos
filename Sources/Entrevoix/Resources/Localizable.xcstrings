    "permission.accessibility_insertion_hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission is only required for automatic insertion. Without it, Entrevoix uses the clipboard." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "L’autorisation d’accessibilité est uniquement requise pour l’insertion automatique. Sans elle, Entrevoix utilise le presse-papiers." } } } },
    "permission.allow_accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Automatic Insertion" } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Autoriser l’insertion automatique" } } } },
