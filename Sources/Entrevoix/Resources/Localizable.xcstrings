    "startup.incompatible.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These settings were written by a newer version of Entrevoix (schema %lld). Update Entrevoix before using this installation so the newer settings are not overwritten." } }, "fr-FR" : { "stringUnit" : { "state" : "translated", "value" : "Ces réglages ont été écrits par une version plus récente de Entrevoix (schéma %lld). Mettez Entrevoix à jour avant d’utiliser cette installation afin de ne pas écraser les réglages récents." } } } },
